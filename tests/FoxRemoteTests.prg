	PROCEDURE TestCreateTableNeverQuotesNames() HELP [Fact, Trait("Category", "CreateTable")]
		LOCAL laE[6], lnI, loDb, loT, lcSql
		=ALINES(laE, "sqlserver,mysql,mariadb,postgresql,firebird,sqlite", 1, ",")
		FOR lnI = 1 TO ALEN(laE)
			loDb = This.Db(laE[lnI])
			loT = loDb.NewTableDef("customers")
			loT.AddColumn("name", "C", 40)
			loT.AddIndex("ix_name", "name")
			loT.AddForeignKey("name", "people", "name")
