	PROCEDURE TestIndexesFollowTheTable() HELP [Fact, Trait("Category", "CreateTable")]
		LOCAL loDb, loT, laL[1], lnN
		loDb = This.Db("sqlserver")
		loT = loDb.NewTableDef("customers")
		loT.AddColumn("name", "C", 40)
		loT.AddColumn("city", "C", 40)
		loT.AddIndex("ix_name", "name", .T.)
		loT.AddIndex("ix_city_name", "city, name")
		lnN = ALINES(laL, loDb.TableScript(loT), 1)
		__assert.Equal(3, lnN)
		__assert.Equal("CREATE TABLE customers (name VARCHAR(40), city VARCHAR(40));", laL[1])
		__assert.Equal("CREATE UNIQUE INDEX ix_name ON customers (name);", laL[2])
		__assert.Equal("CREATE INDEX ix_city_name ON customers (city, name);", laL[3])
	ENDPROC

