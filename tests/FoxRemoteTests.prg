	* ======================================================================== *
	* GenerateScript: the SQL of a .dbf, without a server
	* ======================================================================== *
	PROCEDURE TestGenerateScriptOfADbf() HELP [Fact, Trait("Category", "Migration")]
		LOCAL loDb, lcDbf, lcScript, lcStem
		lcStem = "Fr_Gen" + SUBSTR(SYS(2015), 2)
		lcDbf = ADDBS(SYS(2023)) + lcStem + ".dbf"
		CREATE TABLE (lcDbf) FREE (NAME C(20), BORN D NULL, AMOUNT N(10, 2), NOTES M)
		USE IN (lcStem)
		loDb = CREATEOBJECT("RemotePostgreSql")
		lcScript = loDb.GenerateScript(lcDbf)
		__assert.Equal("CREATE TABLE " + LOWER(lcStem) + " (name VARCHAR(20), born DATE, amount NUMERIC(10, 2), notes TEXT);" + CHR(13) + CHR(10), lcScript)
		loDb = CREATEOBJECT("RemoteFirebird")
		lcScript = loDb.GenerateScript(lcDbf)
		__assert.Equal("CREATE TABLE " + UPPER(lcStem) + " (NAME VARCHAR(20), BORN DATE, AMOUNT NUMERIC(10, 2), NOTES BLOB SUB_TYPE TEXT);" + CHR(13) + CHR(10), lcScript)
		ERASE (lcDbf)
		ERASE (FORCEEXT(lcDbf, "fpt"))
	ENDPROC

	* (Never a..j as a table name in a test: USE IN b closes work area 2, not the table b.)
	PROCEDURE TestGenerateScriptOfAFolder() HELP [Fact, Trait("Category", "Migration")]
		LOCAL loDb, lcDir, lcScript, laL[1]
		lcDir = ADDBS(SYS(2023)) + "fr_gen_dir" + SUBSTR(SYS(2015), 2)
		MKDIR (lcDir)
		CREATE TABLE (ADDBS(lcDir) + "t1") FREE (x I)
		USE IN t1
		CREATE TABLE (ADDBS(lcDir) + "t2") FREE (y C(5))
		USE IN t2
		loDb = CREATEOBJECT("RemoteSqlServer")
		lcScript = loDb.GenerateScript(lcDir)
		__assert.Equal(2, ALINES(laL, lcScript, 1))
		__assert.True("CREATE TABLE t1 (x INTEGER);" $ lcScript, lcScript)
		__assert.True("CREATE TABLE t2 (y VARCHAR(5));" $ lcScript, lcScript)
		ERASE (ADDBS(lcDir) + "t1.dbf")
		ERASE (ADDBS(lcDir) + "t2.dbf")
		RMDIR (lcDir)
	ENDPROC

	PROCEDURE TestGenerateScriptLeavesTheDefaultFolder() HELP [Fact, Trait("Category", "Migration")]
		LOCAL loDb, lcDir, lcBefore
		lcDir = ADDBS(SYS(2023)) + "fr_gen_cd" + SUBSTR(SYS(2015), 2)
		MKDIR (lcDir)
		CREATE TABLE (ADDBS(lcDir) + "t3") FREE (x I)
		USE IN t3
		lcBefore = SYS(5) + SYS(2003)
		loDb = CREATEOBJECT("RemoteMySql")
		loDb.GenerateScript(lcDir)
		__assert.Equal(lcBefore, SYS(5) + SYS(2003))
		__assert.False(USED("c_fr_src_t3"), "the source table was left open")
		ERASE (ADDBS(lcDir) + "t3.dbf")
		RMDIR (lcDir)
	ENDPROC
