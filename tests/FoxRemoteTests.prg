* FoxRemoteTests.prg - FoxRemote 1.0, the SQL it writes and what it does without a server.
*
* No database is needed: these tests build the library objects and look at what they generate
* (column types, CREATE TABLE, connection strings, :parameters, values) and at how they fail
* offline. The 0.x suite of this kind lives in legacy\FoxRemoteTests.prg.
*
* Run: foxproof run --prg tests\FoxRemoteTests.prg

DEFINE CLASS TestRemoteSql AS Custom

	PROCEDURE SetUp
		SET PROCEDURE TO "C:\Desarrollo\IrwinRodriguez.dev\FoxRemote\tests\TestSupport.prg" ADDITIVE
		IF !EMPTY(GETENV("FOXREMOTE_HOME"))
			SET PROCEDURE TO (ADDBS(GETENV("FOXREMOTE_HOME")) + "tests\TestSupport.prg") ADDITIVE
		ENDIF
		FrLoadLibrary()
		SET DECIMALS TO 2
	ENDPROC

	PROCEDURE TearDown
		SET DECIMALS TO 2
		CLOSE TABLES ALL
	ENDPROC

	* A test object of one engine, with protected members reachable through Call().
	FUNCTION Db(tcEngine)
		LOCAL loDb
		DO CASE
		CASE tcEngine == "sqlserver"
			loDb = CREATEOBJECT("XSqlServer")
		CASE tcEngine == "mysql"
			loDb = CREATEOBJECT("XMySql")
		CASE tcEngine == "mariadb"
			loDb = CREATEOBJECT("XMariaDb")
		CASE tcEngine == "postgresql"
			loDb = CREATEOBJECT("XPostgreSql")
		CASE tcEngine == "firebird"
			loDb = CREATEOBJECT("XFirebird")
		CASE tcEngine == "sqlite"
			loDb = CREATEOBJECT("XSqlite")
		ENDCASE
		RETURN loDb
	ENDFUNC

	* One call on a fresh object of one engine (nothing may be chained after a method in VFP).
	FUNCTION C(tcEngine, tcMethod, tv1, tv2, tv3, tv4)
		LOCAL loDb, lnN
		loDb = This.Db(tcEngine)
		lnN = PCOUNT()
		DO CASE
		CASE lnN = 2
			RETURN loDb.Call(tcMethod)
		CASE lnN = 3
			RETURN loDb.Call(tcMethod, tv1)
		CASE lnN = 4
			RETURN loDb.Call(tcMethod, tv1, tv2)
		CASE lnN = 5
			RETURN loDb.Call(tcMethod, tv1, tv2, tv3)
		ENDCASE
		RETURN loDb.Call(tcMethod, tv1, tv2, tv3, tv4)
	ENDFUNC

	FUNCTION P(tcEngine, tcProperty)
		LOCAL loDb
		loDb = This.Db(tcEngine)
		RETURN GETPEM(loDb, tcProperty)
	ENDFUNC

	* Asserts the SQL type of every VFP type for one engine.
	PROCEDURE CheckTypes(tcEngine, tcText, tcDouble, tcDateTime, tcBool, tcBlob, tcAutoKey)
		LOCAL loDb
		loDb = This.Db(tcEngine)
		__assert.Equal("VARCHAR(10)", loDb.Call("ColumnType", "C", 10, 0), tcEngine + " C(10)")
		__assert.Equal("VARCHAR(20)", loDb.Call("ColumnType", "V", 20, 0), tcEngine + " V(20)")
		__assert.Equal(tcText, loDb.Call("ColumnType", "M", 4, 0), tcEngine + " M")
		__assert.Equal("NUMERIC(10, 2)", loDb.Call("ColumnType", "N", 10, 2), tcEngine + " N(10,2)")
		__assert.Equal("INTEGER", loDb.Call("ColumnType", "I", 4, 0), tcEngine + " I")
		__assert.Equal(tcDouble, loDb.Call("ColumnType", "B", 8, 2), tcEngine + " B")
		__assert.Equal(tcDouble, loDb.Call("ColumnType", "F", 12, 3), tcEngine + " F")
		__assert.Equal("NUMERIC(19, 4)", loDb.Call("ColumnType", "Y", 8, 4), tcEngine + " Y")
		__assert.Equal("DATE", loDb.Call("ColumnType", "D", 8, 0), tcEngine + " D")
		__assert.Equal(tcDateTime, loDb.Call("ColumnType", "T", 8, 0), tcEngine + " T")
		__assert.Equal(tcBool, loDb.Call("ColumnType", "L", 1, 0), tcEngine + " L")
		__assert.Equal(tcBlob, loDb.Call("ColumnType", "G", 4, 0), tcEngine + " G")
		__assert.Equal(tcBlob, loDb.Call("ColumnType", "W", 4, 0), tcEngine + " W")
		__assert.Equal(tcAutoKey, loDb.Call("AutoKeyType"), tcEngine + " auto key")
	ENDPROC

