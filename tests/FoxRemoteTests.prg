	* N9: SQLite stores UTF-8 and its driver does not convert: the parameters go converted.
	PROCEDURE TestSqliteParametersGoAsUtf8() HELP [Fact, Trait("Category", "Parameters")]
		LOCAL loP, loOut
		loP = CREATEOBJECT("Empty")
		ADDPROPERTY(loP, "name", "Pe" + CHR(241) + "a")
		ADDPROPERTY(loP, "qty", 3)
		loOut = This.C("sqlite", "PrepareParams", loP)
		__assert.Equal(STRCONV("Pe" + CHR(241) + "a", 9), loOut.name)
		__assert.Equal(3, loOut.qty)
		__assert.Equal("Pe" + CHR(241) + "a", loP.name, "the caller's object must not change")
	ENDPROC

