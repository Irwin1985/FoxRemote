* ======================================================================== *
* Test subclasses: Call() reaches the protected members from inside the class.
* ======================================================================== *

DEFINE CLASS XSqlServer AS RemoteSqlServer
	FUNCTION Call(tcMethod, tv1, tv2, tv3, tv4)
		LOCAL lnN
		lnN = PCOUNT()
		DO CASE
		CASE lnN = 1
			RETURN EVALUATE("This." + tcMethod + "()")
		CASE lnN = 2
			RETURN EVALUATE("This." + tcMethod + "(tv1)")
		CASE lnN = 3
			RETURN EVALUATE("This." + tcMethod + "(tv1, tv2)")
		CASE lnN = 4
			RETURN EVALUATE("This." + tcMethod + "(tv1, tv2, tv3)")
		ENDCASE
		RETURN EVALUATE("This." + tcMethod + "(tv1, tv2, tv3, tv4)")
	ENDFUNC
ENDDEFINE

